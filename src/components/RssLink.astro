---
import { localePath, type Lang } from "../lib/i18n";
interface Props { ui: { journal: { rss: string } }; lang: Lang }
const { ui, lang } = Astro.props;
const base = import.meta.env.BASE_URL;
const href = `${localePath(lang, "journal", base).replace(/\/?$/, "/")}rss.xml`;
---
<p class="muted"><a href={href}>{ui.journal.rss}</a></p>
