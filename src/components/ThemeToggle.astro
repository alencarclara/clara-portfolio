---
interface Props { toLight: string; toDark: string; label: string }
const { toLight, toDark, label } = Astro.props;
---
<button id="theme-toggle" type="button" class="theme-toggle" aria-label={label} data-to-light={toLight} data-to-dark={toDark}>{toLight}</button>

<script>
  const btn = document.getElementById("theme-toggle") as HTMLButtonElement;
  const root = document.documentElement;
  const render = () => {
    btn.textContent = root.getAttribute("data-theme") === "light" ? btn.dataset.toDark! : btn.dataset.toLight!;
  };
  btn.addEventListener("click", () => {
    const next = root.getAttribute("data-theme") === "light" ? "dark" : "light";
    root.setAttribute("data-theme", next);
    try { localStorage.setItem("theme", next); } catch (e) { /* sem armazenamento: vale só nesta página */ }
    render();
  });
  render();
</script>
