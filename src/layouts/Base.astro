---
import "@fontsource/jetbrains-mono/latin-400.css";
import "@fontsource/jetbrains-mono/latin-700.css";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { getUi } from "../lib/ui";
import { getPublishedByLang } from "../lib/published";
import { htmlLang, otherLang, localePath, type Lang, type Page, type PagePath } from "../lib/i18n";

// path: subcaminho do Journal (ex.: "journal/day/2026-11-15"); sem ele vale `current`.
interface Props { title: string; current: "home" | Page; lang: Lang; path?: PagePath }
const { title, current, lang, path } = Astro.props;
const ui = await getUi(lang);
const about = (await getPublishedByLang("about", lang))[0];
if (!about) throw new Error(`src/content/about/${lang}.md não encontrado`);
const linkedin = about.data.linkedin_url;
const base = import.meta.env.BASE_URL;
const other = otherLang(lang);
const otherHref = localePath(other, path ?? (current === "home" ? undefined : current), base);
const selfHref = localePath(lang, path ?? (current === "home" ? undefined : current), base);
// Com `site` (build de deploy): URLs absolutas, canonical e x-default. Sem ele, só o alternate relativo.
const site = Astro.site;
const abs = (p: string) => (site ? new URL(p, site).href : p);
---
<!doctype html>
<html lang={htmlLang[lang]} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === ui.site.name ? title : `${title} · ${ui.site.name}`}</title>
    {site && <link rel="canonical" href={abs(selfHref)} />}
    {site && <link rel="alternate" hreflang={lang} href={abs(selfHref)} />}
    <link rel="alternate" hreflang={other} href={abs(otherHref)} />
    {current === "journal" && <link rel="alternate" type="application/rss+xml" title={`${ui.pages.journal.title} · ${ui.site.name}`} href={`${base.endsWith("/") ? base : `${base}/`}${lang}/journal/rss.xml`} />}
    {site && <link rel="alternate" hreflang="x-default" href={abs(base.endsWith("/") ? base : `${base}/`)} />}
    <script is:inline>
      try {
        var t = localStorage.getItem("theme");
        if (t === "light" || t === "dark") document.documentElement.setAttribute("data-theme", t);
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">{ui.site.skip}</a>
    <Header ui={ui} current={current} lang={lang} otherHref={otherHref} />
    <main id="main"><slot /></main>
    <Footer ui={ui} linkedin={linkedin} />
  </body>
</html>
