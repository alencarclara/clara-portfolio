---
import "@fontsource/jetbrains-mono/latin-400.css";
import "@fontsource/jetbrains-mono/latin-700.css";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { getUi } from "../lib/ui";
import { getPublishedByLang } from "../lib/published";
import { htmlLang, otherLang, localePath, type Lang, type Page } from "../lib/i18n";

interface Props { title: string; current: "home" | Page; lang: Lang }
const { title, current, lang } = Astro.props;
const ui = await getUi(lang);
const about = (await getPublishedByLang("about", lang))[0];
if (!about) throw new Error(`src/content/about/${lang}.md não encontrado`);
const linkedin = about.data.linkedin_url;
const base = import.meta.env.BASE_URL;
const other = otherLang(lang);
const otherHref = localePath(other, current === "home" ? undefined : current, base);
---
<!doctype html>
<html lang={htmlLang[lang]} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === ui.site.name ? title : `${title} · ${ui.site.name}`}</title>
    <link rel="alternate" hreflang={other} href={otherHref} />
    <script is:inline>
      try {
        var t = localStorage.getItem("theme");
        if (t === "light" || t === "dark") document.documentElement.setAttribute("data-theme", t);
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">{ui.site.skip}</a>
    <Header ui={ui} current={current} lang={lang} otherHref={otherHref} />
    <main id="main"><slot /></main>
    <Footer ui={ui} linkedin={linkedin} />
  </body>
</html>
