---
import "@fontsource/jetbrains-mono/latin-400.css";
import "@fontsource/jetbrains-mono/latin-700.css";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { getUi } from "../lib/ui";
import { getPublished } from "../lib/published";

interface Props { title: string; current: string }
const { title, current } = Astro.props;
const ui = await getUi();
const about = (await getPublished("about")).find((e) => e.id === "pt");
const linkedin = about!.data.linkedin_url;
---
<!doctype html>
<html lang="pt-BR" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === ui.site.name ? title : `${title} · ${ui.site.name}`}</title>
    <script is:inline>
      try {
        var t = localStorage.getItem("theme");
        if (t === "light" || t === "dark") document.documentElement.setAttribute("data-theme", t);
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">{ui.site.skip}</a>
    <Header ui={ui} current={current} />
    <main id="main"><slot /></main>
    <Footer ui={ui} linkedin={linkedin} />
  </body>
</html>
