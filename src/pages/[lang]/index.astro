---
import { Image } from "astro:assets";
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { getUi } from "../../lib/ui";
import { LANGS, localePath, type Lang } from "../../lib/i18n";
import { getPublishedByLang } from "../../lib/published";

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const ui = await getUi(lang);
const entry = (await getPublishedByLang("about", lang))[0];
if (!entry) throw new Error(`src/content/about/${lang}.md não encontrado`);
const { Content } = await render(entry);
const { title, cta_label, photo, photo_alt, linkedin_url } = entry.data;

const images = import.meta.glob<{ default: ImageMetadata }>("../../assets/*.{jpg,jpeg,png,webp}", { eager: true });
const photoSrc = photo ? Object.entries(images).find(([p]) => p.endsWith(`/${photo}`))?.[1].default : undefined;
if (photo && !photoSrc) throw new Error(`foto não encontrada em src/assets: ${photo}`);

const pages = [
  [localePath(lang, "activities", import.meta.env.BASE_URL), ui.pages.activities.title],
  [localePath(lang, "experience", import.meta.env.BASE_URL), ui.pages.experience.title],
  [localePath(lang, "courses", import.meta.env.BASE_URL), ui.pages.courses.title],
  [localePath(lang, "projects", import.meta.env.BASE_URL), ui.pages.projects.title],
  [localePath(lang, "journal", import.meta.env.BASE_URL), ui.pages.journal.title],
] as const;
---
<Base title={ui.site.name} current="home" lang={lang}>
  <section class="hero">
    {photoSrc && <Image src={photoSrc} alt={photo_alt!} width={320} height={320} />}
    <div class="hero-text">
      <p class="label">{ui.home.whoami}</p>
      <h1>{title}</h1>
      <div class="prose"><Content /></div>
      <p>
        <a class="button" href="#paginas">{cta_label}</a>
        {" "}
        <a href={linkedin_url} rel="noopener noreferrer">{ui.home.contact}</a>
      </p>
    </div>
  </section>
  <hr />
  <section id="paginas">
    <h2 class="label">{ui.home.pages}</h2>
    <ul class="page-list">
      {pages.map(([href, label]) => <li><a href={href}>{label}</a></li>)}
    </ul>
  </section>
</Base>
