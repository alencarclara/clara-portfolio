---
import Base from "../../../../layouts/Base.astro";
import { getUi } from "../../../../lib/ui";
import { LANGS, localePath, type Lang } from "../../../../lib/i18n";
import { getJournal } from "../../../../lib/journal-data";
import { groupByDay, longDate, tagSlug } from "../../../../lib/journal";

export async function getStaticPaths() {
  const paths = [];
  for (const lang of LANGS) {
    for (const date of groupByDay(await getJournal(lang)).keys()) paths.push({ params: { lang, date } });
  }
  return paths;
}
const { lang, date } = Astro.params as { lang: Lang; date: string };
const ui = await getUi(lang);
const base = import.meta.env.BASE_URL;
const entries = groupByDay(await getJournal(lang)).get(date) ?? [];
const title = longDate(date, ui.journal.monthNames, lang);
---
<Base title={title} current="journal" lang={lang} path={`journal/day/${date}`}>
  <h1>{title}</h1>
  <p><a href={localePath(lang, `journal/month/${date.slice(0, 7)}`, base)}>← {ui.journal.backToCalendar}</a></p>
  {entries.map((e) => (
    <article class="card" lang={e.untranslated ? e.data.lang : undefined}>
      <h2>{e.data.title}</h2>
      {e.untranslated && <p class="muted">{ui.journal.untranslated}</p>}
      <p class="subhead">{ui.journal.did}</p>
      <p>{e.data.did}</p>
      <p class="subhead">{ui.journal.learned}</p>
      <p>{e.data.learned}</p>
      <p class="muted">
        {ui.journal.tags}:{" "}
        {e.data.tags.map((t, i) => (
          <>{i > 0 && ", "}<a href={localePath(lang, `journal/themes/${tagSlug(t)}`, base)}>{t}</a></>
        ))}
      </p>
      {e.data.links && e.data.links.length > 0 && (
        <>
          <p class="subhead">{ui.journal.links}</p>
          <ul>{e.data.links.map((l) => <li><a href={l} rel="noopener noreferrer">{l}</a></li>)}</ul>
        </>
      )}
    </article>
  ))}
</Base>
