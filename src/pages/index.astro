---
import "@fontsource/jetbrains-mono/latin-400.css";
import "@fontsource/jetbrains-mono/latin-700.css";
import "../styles/global.css";
import { getUi } from "../lib/ui";
import { LANGS, localePath } from "../lib/i18n";

// Raiz: escolhe o idioma pelo navegador (script); sem JS, os dois links ficam visíveis, PT primeiro.
const base = import.meta.env.BASE_URL;
const uis = await Promise.all(LANGS.map((l) => getUi(l)));
const options = LANGS.map((l, i) => ({ lang: l, href: localePath(l, undefined, base), name: uis[i].langSwitch.name }));
const title = uis[0].site.name;
---
<!doctype html>
<html lang="pt-BR" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <script is:inline>
      try {
        var t = localStorage.getItem("theme");
        if (t === "light" || t === "dark") document.documentElement.setAttribute("data-theme", t);
      } catch (e) {}
    </script>
  </head>
  <body>
    <main id="main">
      <h1>{title}</h1>
      <ul class="page-list">
        {options.map((o) => <li><a href={o.href} hreflang={o.lang} lang={o.lang}>{o.name}</a></li>)}
      </ul>
    </main>
    <script is:inline>
      (function () {
        var l = (navigator.languages && navigator.languages[0]) || navigator.language || "";
        var target = document.querySelector('a[hreflang="' + (l.toLowerCase().indexOf("en") === 0 ? "en" : "pt") + '"]');
        if (target) location.replace(target.getAttribute("href"));
      })();
    </script>
  </body>
</html>
